// Cloudflare hosting: the built site (dist) served as static files.
// Build command: npm run build   ·   Deploy command: npx wrangler deploy
{
  "name": "mirella-babyshower",
  "compatibility_date": "2026-06-01",
  // Build the site before every upload (branch previews skip the dashboard's build command).
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Unknown paths fall back to the app (pages use #/ links, so this is just a safety net).
    "not_found_handling": "single-page-application"
  },
  // Branch previews (Cloudflare runs `wrangler preview` for non-main branches).
  // Empty: previews serve the same static files; the production settings above are unchanged.
  "previews": {}
}
